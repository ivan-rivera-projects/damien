# Damien v2 — copy to ~/.damien/.env and fill in.
# Never commit real values.

# The Gmail account this install works on. Used only to label stored rows.
DAMIEN_ACCOUNT=

# Where state lives (default: ~/.damien). Holds damien.db, rules.json, credentials.json, token.json.
# DAMIEN_HOME=

# ---- where state lives ------------------------------------------------
# Unset = SQLite at $DAMIEN_HOME/damien.db (zero infrastructure).
# Set   = Postgres. Note: a connection string holds a password; keep this file at 0600.
# DAMIEN_DB_URL=postgres://conspire_app:PASSWORD@127.0.0.1:5433/damien

# ---- judgment ---------------------------------------------------------
# rules      = deterministic only, no model calls
# openrouter = Jev through OpenRouter (uses OPENROUTER_API_KEY)
# typesafe   = Jev direct (uses TYPESAFE_API_KEY)
# fake       = deterministic stand-in, for a dry run with no key
DAMIEN_JUDGE=rules

# Pin the version whose behaviour your thresholds were tuned against.
DAMIEN_MODEL=typesafe/jev-1.13

OPENROUTER_API_KEY=
# TYPESAFE_API_KEY=

# ---- thresholds -------------------------------------------------------
# >= this: act unattended.  Below: keep it, hand it to a person.  (Docs suggest 0.5 floor, 0.9 destructive.)
DAMIEN_CONFIDENCE_ACT=0.80
DAMIEN_CONFIDENCE_ASK=0.55

# ---- throughput -------------------------------------------------------
DAMIEN_PAGE_SIZE=500        # Gmail list page (<=500)
DAMIEN_OP_BATCH=1000        # ids per batchModify call (Gmail cap 1000)
DAMIEN_JUDGE_BATCH=8        # concurrent Jev requests (docs cap the public endpoint near 8)

# ---- paths ------------------------------------------------------------
# DAMIEN_DB=
# DAMIEN_CREDENTIALS=        # the Google OAuth desktop client JSON
# DAMIEN_TOKEN=              # written by `damien login`
